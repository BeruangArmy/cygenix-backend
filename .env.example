# Copy this file to .env and fill in real values.
# Get these from Firebase Console > Project Settings > Service Accounts >
# Generate new private key (downloads a JSON file — copy project_id,
# client_email, and private_key out of it into the vars below).

PORT=4000

FIREBASE_PROJECT_ID=cygenix-xxxxx
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@cygenix-xxxxx.iam.gserviceaccount.com
# Keep the \n escapes and the surrounding quotes exactly as downloaded.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nXXXX\n-----END PRIVATE KEY-----\n"

# Comma-separated list of origins allowed to call this API (Flutter web dev
# server, etc). Native Android/iOS builds aren't affected by CORS.
CORS_ORIGINS=http://localhost:5000,http://localhost:3000
